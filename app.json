{
  "expo": {
    "name": "FinanceFlow",
    "slug": "financeflow",
    "version": "1.0.0", 
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "financeflow",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danukaji.financeflow"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.danukaji.financeflow"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
