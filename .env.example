# ===========================================
# FINANCEFLOW ENVIRONMENT VARIABLES TEMPLATE
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!

# -------------------------------------------
# FIREBASE CONFIGURATION (Required)
# Get these from Firebase Console > Project Settings > General > Your apps
# -------------------------------------------
EXPO_PUBLIC_FB_API_KEY=your_api_key_here
EXPO_PUBLIC_FB_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FB_PROJECT_ID=your_project_id
EXPO_PUBLIC_FB_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FB_MESSAGING_SENDER_ID=your_sender_id_here
EXPO_PUBLIC_FB_APP_ID=your_app_id_here

# -------------------------------------------
# GOOGLE SIGN-IN CONFIGURATION (Required for Google Auth & Email Import)
# Get these from Google Cloud Console > APIs & Services > Credentials
# -------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# -------------------------------------------
# OPTIONAL: DEBUG/DEVELOPMENT FLAGS
# -------------------------------------------
# EXPO_PUBLIC_DEBUG_MODE=true
# EXPO_PUBLIC_DEFAULT_CURRENCY=USD
